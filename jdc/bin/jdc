#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
TARGET="${REPO_ROOT}/homelab-cli/jdc"

if [[ ! -x "${TARGET}" ]]; then
  echo "error: ${TARGET} is missing or not executable; run 'make install-jdc'" >&2
  exit 1
fi

exec "${TARGET}" "$@"
